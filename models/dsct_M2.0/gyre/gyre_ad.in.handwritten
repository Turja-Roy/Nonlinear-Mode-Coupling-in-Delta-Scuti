! Adiabatic eigenmodes: frequencies and eigenfunctions for the coupling integrals.

&constants
/

&model
  model_type = 'EVOL'
  file = '../mesa/LOGS/profile331.data.GYRE'
  file_format = 'MESA'
/

! m is not set: the star is nonrotating, so omega is m-degenerate and the
! m dependence of kappa_abc is handled analytically in the angular integrals.
&mode
  l = 0
  n_pg_min = -20
  n_pg_max = 20
  tag = 'l0'
/

&mode
  l = 1
  n_pg_min = -20
  n_pg_max = 20
  tag = 'l1'
/

&mode
  l = 2
  n_pg_min = -20
  n_pg_max = 20
  tag = 'l2'
/

&mode
  l = 3
  n_pg_min = -20
  n_pg_max = 20
  tag = 'l3'
/

&osc
  outer_bound = 'UNNO'
  variables_set = 'DZIEM'
/

&rot
/

&num
  diff_scheme = 'COLLOC_GL4'
/

! Two scans because g- and p-modes are evenly spaced in different variables.
! Ranges come from this model: asymptotic g-mode frequencies run 1.2-57 c/d
! over l = 1-3, n = 1-20, and p-modes 11-88 c/d, against an acoustic cutoff
! of 88.7 c/d.
&scan
  grid_type = 'INVERSE'
  freq_min = 0.8
  freq_max = 25.0
  n_freq = 1000
  freq_units = 'CYC_PER_DAY'
/

&scan
  grid_type = 'LINEAR'
  freq_min = 25.0
  freq_max = 95.0
  n_freq = 1000
  freq_units = 'CYC_PER_DAY'
/

&grid
  w_osc = 10
  w_exp = 2
  w_ctr = 10
/

! U_D would give dlnrho/dlnr directly but exists only for polytropes, so As,
! V_2 and Gamma_1 are carried instead: dlnrho/dlnr = -V_2*x^2/Gamma_1 - As.
! lag_rho is in units of rho, so div.xi = -lag_rho exactly, for every l. The
! horizontal Euler route needs xi_h, which GYRE sets to 0 for l = 0.
&ad_output
  summary_file = 'summary_ad.h5'
  summary_item_list = 'id,l,m,n_pg,n_p,n_g,omega,freq,E_norm,Delta_p,Delta_g,M_star,R_star,L_star'
  detail_template = 'detail/detail.l%l.n%n.h5'
  detail_item_list = 'id,l,m,n_pg,n_p,n_g,omega,freq,x,xi_r,xi_h,eul_Phi,deul_Phi,eul_P,lag_P,eul_rho,lag_rho,rho,P,Gamma_1,As,U,c_1,V_2,M_r,M_star,R_star,L_star,E_norm'
  freq_units = 'CYC_PER_DAY'
/

&nad_output
/
